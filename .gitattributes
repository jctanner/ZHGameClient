# Auto-detect text files and normalize to LF
* text=auto

# Explicitly declare text files you want to normalize
*.c     text
*.cpp   text
*.h     text
*.cmake text
*.txt   text
*.md    text
*.yaml  text
*.yml   text
*.json  text
*.sh    text eol=lf
*.py    text eol=lf

# Windows scripts should keep CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files
*.exe   binary
*.dll   binary
*.lib   binary
*.obj   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.bmp   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
